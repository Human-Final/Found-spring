<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.human.found.domain.found.mapper.FoundFileMapper">
<insert id="insertFile"
        parameterType="com.human.found.domain.found.vo.FoundFileVO">
    INSERT INTO found_file(
        fd_filepath_img,
        board_id,
        save_name,
        file_size,
        file_path
    )VALUES(
        #{fdFilepathImg},
        #{boardId},
        #{saveName},
        #{fileSize},
        #{filePath}

    )    

</insert>


</mapper>        