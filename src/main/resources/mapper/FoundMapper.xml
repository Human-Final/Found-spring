    <!--유니온-->
        <select id="selectFoundList"
    resultType="com.human.found.domain.found.vo.FoundVO">
        SELECT 
            num,
            atc_id,
            id,
            clr_num,
            dep_place,
            fd_filepath_img,
            fd_prdt_num,
            fd_sbjt,
            fd_ymd,
            prdt_cl_num,
            done,
            deleted
        FROM found
        WHERE 
            deleted=0 
        
        UNION ALL   
        
                SELECT 
            num,
            atc_id,
            id,
            clr_num,
            dep_place,
            fd_filepath_img,
            fd_prdt_num,
            fd_sbjt,
            fd_ymd,
            prdt_cl_num,
            done,
            is_deleted
        FROM found_police
        WHERE 
            deleted=0 
        ORDER BY fd_ymd DESC

    </select>




</mapper>        
