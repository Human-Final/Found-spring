<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.human.found.domain.found.mapper.FoundMapper">


<insert id="insertfound"
        parameterType="com.human.found.domain.found.vo.FoundVO"
        useGeneratedKeys="true"
        keyProperty="num">
    
    INSERT INTO found(
    atc_id,
    id,
    clr_num,
    dep_place,
    fd_filepath_img,
    fd_prdt_num,
    fd_sbjt,
    fd_ymd,
    prdt_cl_num,
    done,
    is_deleted

    )VALUES(
    #{atcId},
    #{id},
    #{clrNum},
    #{depPlace},
    #{fdFilepathImg},
    #{fdPrdtNum},
    #{fdSbjt},
    #{fdYmd},
    #{prdtClNum},
    #{done},
    #{deleted}
    )
    
    
    </insert>

