<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.human.found.domain.user.mapper.UserMapper">

    <resultMap id="userMap"
               type="com.human.found.domain.user.vo.UserVO">

        <id property="id" column="id"/>

        <result property="pw" column="pw"/>
        <result property="email" column="email"/>
        <result property="tel" column="tel"/>
        <result property="role" column="role"/>
        
        <result property="signUp" column="sign_up"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="deleted" column="deleted"/>

    </resultMap>

    <select id="findById"
            parameterType="String"
            resultMap="userMap">

        SELECT *
        FROM member
        WHERE id = #{id}

    </select>

    <insert id = "insertUser" 
            parameterType = "com.human.found.domain.user.vo.UserVO">
        INSERT INTO member (
            id,
            pw,
            email,
            tel,
            role,
            sign_up,
            is_deleted
        )
        VALUES (
            #{id},
            #{pw},
            #{email},
            #{tel},
            'USER',
            NOW(),
            0
        )
    </insert>

    <select id = "countById"
            parameterType = "String"
            resultType = "int">

            SELECT COUNT(*)
            FROM member
            WHERE id = #{id}
    </select>

    <select id="countByEmail"
            parameterType="String"
            resultType="int">

        SELECT COUNT(*)
        FROM member
        WHERE email = #{email}

    </select>
</mapper>