            lst_filepath_img,
            view_count
        FROM lost
        WHERE is_deleted = 0
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 경찰청 API 분실물 페이징 조회 -->
