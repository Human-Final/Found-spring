            updated_at,
            is_deleted
        FROM notice
        WHERE is_deleted = 0
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 사용자 등록 분실물 전체 개수 조회 -->
    <select id="countLost" resultType="int">
        SELECT COUNT(*)
        FROM lost
        WHERE is_deleted = 0
    </select>

    <!-- 경찰청 API 분실물 전체 개수 조회 -->
    <select id="countPoliceLost" resultType="int">
        SELECT COUNT(*)
        FROM lost_police
