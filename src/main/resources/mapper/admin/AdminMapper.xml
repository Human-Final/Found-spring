            is_deleted
        FROM found_police
        WHERE is_deleted = 0
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 관리자 등록 공지사항 페이징 조회 -->
    <select id="selectNoticePage" resultMap="AdminNoticeResultMap">
