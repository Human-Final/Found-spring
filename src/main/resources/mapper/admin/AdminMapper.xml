    <!-- 관리자 공지사항 조회 결과 매핑 -->
    <resultMap id="AdminNoticeResultMap"
            type="com.human.found.domain.admin.vo.AdminNoticeVO">

        <id property="num" column="num"/>

        <result property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="viewCount" column="view_count"/>
        <result property="isPlanned" column="is_planned"/>
        <result property="isImportant" column="is_important"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <!-- 관리자 등록 공지사항 전체 조회 -->
    <select id="selectNoticeList" resultMap="AdminNoticeResultMap">
        SELECT
            num,
            id,
            title,
            content,
            view_count,
            is_planned,
            is_important,
            created_at,
            updated_at,
            is_deleted
        FROM notice
        WHERE is_deleted = 0
        ORDER BY created_at DESC
    </select>

