            done,
            is_deleted
        FROM found
        WHERE is_deleted = 0
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 경찰청 API 습득물 페이징 조회 -->
    <select id="selectPoliceFoundPage" resultMap="AdminFoundResultMap">
        SELECT
            num,
            atc_id,
