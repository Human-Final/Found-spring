<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.human.found.domain.admin.mapper.AdminMapper">

    <!-- 관리자 분실물 게시글 조회 결과 매핑 -->
    <resultMap id="AdminLostResultMap"
               type="com.human.found.domain.admin.vo.AdminLostVO">

        <id property="num" column="num"/>

        <result property="atcId" column="atc_id"/>
        <result property="id" column="id"/>
        <result property="lstPlace" column="lst_place"/>
        <result property="lstPrdtNm" column="lst_prdt_nm"/>
        <result property="lstSbjt" column="lst_sbjt"/>
        <result property="lstYmd" column="lst_ymd"/>
        <result property="prdtClNm" column="prdt_cl_nm"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="done" column="done"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="lstFilepathImg" column="lst_filepath_img"/>
        <result property="viewConut" column="view_conut"/>
    </resultMap>

    <!-- 사용자 등록 분실물 게시글 전체 조회 -->
    <select id="selectLostList" resultMap="AdminLostResultMap">
        SELECT
            num,
            atc_id,
            id,
            lst_place,
            lst_prdt_nm,
            lst_sbjt,
            lst_ymd,
            prdt_cl_nm,
            created_at,
            updated_at,
            done,
            is_deleted,
            lst_filepath_img,
            view_conut
        FROM lost
        WHERE is_deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- 사용자 등록 분실물 게시글 단일 논리 삭제 -->
    <update id="deleteLost">
        UPDATE lost
        SET is_deleted = 1
        WHERE num = #{num}
    </update>

    <!-- 사용자 등록 분실물 게시글 선택 삭제 -->
    <update id="deleteLostList">
        UPDATE lost
        SET is_deleted = 1
        WHERE num IN
        <foreach collection="nums"
                item="num"
                open="("
                separator=","
                close=")">
            #{num}
        </foreach>
    </update>

    <!-- 경찰청 API 분실물 선택 삭제 -->
    <update id="deletePoliceLostList">
        UPDATE lost_police
        SET is_deleted = 1
        WHERE num IN
        <foreach collection="nums" item="num" open="(" separator="," close=")">
            #{num}
        </foreach>
    </update>

    <!-- 관리자 습득물 게시글 조회 결과 매핑 -->
    <resultMap id="AdminFoundResultMap"
            type="com.human.found.domain.admin.vo.AdminFoundVO">

        <id property="num" column="num"/>

        <result property="atcId" column="atc_id"/>
        <result property="id" column="id"/>
        <result property="clrNm" column="clr_nm"/>
        <result property="depPlace" column="dep_place"/>
        <result property="fdFilepathImg" column="fd_filepath_img"/>
        <result property="fdPrdtNm" column="fd_prdt_nm"/>
        <result property="fdSbjt" column="fd_sbjt"/>
        <result property="fdYmd" column="fd_ymd"/>
        <result property="prdtClNm" column="prdt_cl_nm"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="done" column="done"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <!-- 사용자 등록 습득물 전체 조회 -->
    <select id="selectFoundList" resultMap="AdminFoundResultMap">
        SELECT
            num,
            atc_id,
            id,
            clr_nm,
            dep_place,
            fd_filepath_img,
            fd_prdt_nm,
            fd_sbjt,
            fd_ymd,
            prdt_cl_nm,
            created_at,
            updated_at,
            done,
            is_deleted
        FROM found
        WHERE is_deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- 경찰청 API 습득물 전체 조회 -->
    <select id="selectPoliceFoundList" resultMap="AdminFoundResultMap">
        SELECT
            num,
            atc_id,
            id,
            clr_nm,
            dep_place,
            fd_filepath_img,
            fd_prdt_nm,
            fd_sbjt,
            fd_ymd,
            prdt_cl_nm,
            created_at,
            updated_at,
            done,
            is_deleted
        FROM found_police
        WHERE is_deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- 사용자 등록 습득물 선택 삭제 -->
    <update id="deleteFoundList">
        UPDATE found
        SET is_deleted = 1
        WHERE num IN
        <foreach collection="nums" item="num" open="(" separator="," close=")">
            #{num}
        </foreach>
    </update>

    <!-- 경찰청 API 습득물 선택 삭제 -->
    <update id="deletePoliceFoundList">
        UPDATE found_police
        SET is_deleted = 1
        WHERE num IN
        <foreach collection="nums" item="num" open="(" separator="," close=")">
            #{num}
        </foreach>
    </update>

</mapper>