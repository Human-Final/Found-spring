<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.human.found.domain.admin.mapper.UserManageMapper">    
    
    <!-- 유저 권한 변경-->
    <update id="updateUserStatusByIds">
        UPDATE user
        SET 
            status = #{status},
            is_deleted = #{isDeleted},
            deleted_at =
            CASE
                WHEN #{isDeleted} = 1 THEN NOW()
                WHEN #{isDeleted} = 0 THEN NULL
                ELSE deleted_at
            END 
        WHERE id IN
        <foreach collection="userIds"
                item="id"
                open="("
                separator=","
                close=")">
            #{id}
        </foreach>
    </update>

    <!-- 유저 전체 리스트 조회 -->
    <select id="totalUserList"
            resultType="com.human.found.domain.user.vo.UserVO">
        SELECT 
            id,
            name,
            email,
            tel,
            role,
            sign_up,
            status,
            is_deleted
            deleted_at
        FROM user
    </select>

</mapper>