<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.human.found.domain.admin.mapper.BoardManageMapper">

    <!-- 관리자 분실물 게시글 조회 결과 매핑 -->
    <resultMap id="AdminLostResultMap"
               type="com.human.found.domain.admin.vo.AdminLostVO">

        <id property="num" column="num"/>

        <result property="atcId" column="atc_id"/>
        <result property="id" column="id"/>
        <result property="lstPlace" column="lst_place"/>
        <result property="lstPrdtNm" column="lst_prdt_nm"/>
        <result property="lstSbjt" column="lst_sbjt"/>
        <result property="lstYmd" column="lst_ymd"/>
        <result property="prdtClNm" column="prdt_cl_nm"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="done" column="done"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="lstFilepathImg" column="lst_filepath_img"/>
        <result property="viewCount" column="view_count"/>
        <result property="dataSource" column="data_source"/>
    </resultMap>

    <!-- 관리자 습득물 게시글 조회 결과 매핑 -->
    <resultMap id="AdminFoundResultMap"
               type="com.human.found.domain.admin.vo.AdminFoundVO">

        <id property="num" column="num"/>

        <result property="atcId" column="atc_id"/>
        <result property="id" column="id"/>
        <result property="clrNm" column="clr_nm"/>
        <result property="depPlace" column="dep_place"/>
        <result property="fdFilepathImg" column="fd_filepath_img"/>
        <result property="fdPrdtNm" column="fd_prdt_nm"/>
        <result property="fdSbjt" column="fd_sbjt"/>
        <result property="fdYmd" column="fd_ymd"/>
        <result property="prdtClNm" column="prdt_cl_nm"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="done" column="done"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="dataSource" column="data_source"/>
    </resultMap>

    <!-- 사용자 등록 분실물 선택 삭제 -->
    <update id="deleteLostList" parameterType="list">
        UPDATE lost l, lost_police lp
        SET 
            l.is_deleted = 1,
            lp.is_deleted = 1
        WHERE l.atc_id IN (
            SELECT atc_id FROM (
                SELECT atc_id FROM lost WHERE atc_id IN 
                <foreach collection="atcId" item="atcId" open="(" separator="," close=")">
                    #{atcId}
                </foreach>
                UNION
                SELECT atc_id FROM lost_police WHERE atc_id IN 
                <foreach collection="atcId" item="atcId" open="(" separator="," close=")">
                    #{atcId}
                </foreach>
            ) AS tmp
        ) OR lp.atc_id IN (
            SELECT atc_id FROM (
                SELECT atc_id FROM lost WHERE atc_id IN 
                <foreach collection="atcId" item="atcId" open="(" separator="," close=")">
                    #{atcId}
                </foreach>
                UNION
                SELECT atc_id FROM lost_police WHERE atc_id IN 
                <foreach collection="atcId" item="atcId" open="(" separator="," close=")">
                    #{atcId}
                </foreach>
            ) AS tmp
        )
    </update>

    <!-- 사용자 분실물 완료처리 -->
    <update id="completeLostList">
        update lost
        set done=1
        where atc_id=#{atcId}
    </update>

    <!-- 경찰청 분실물 완료처리 -->
    <update id="completeLostPoliceList">
        update lost_police
        set done=1
        where atc_id=#{atcId}
    </update>

    <!-- 1. 사용자 습득물 삭제 -->
    <update id="deleteFoundList">
        UPDATE found
        SET is_deleted = 1
        WHERE atc_id = #{atcId}
    </update>

    <!-- 2. 경찰 습득물 삭제 -->
    <update id="deleteFoundPoliceList">
        UPDATE found_police
        SET is_deleted = 1
        WHERE atc_id = #{atcId}
    </update>

    <!-- 3. 포털 습득물 삭제 -->
    <update id="deleteFoundPortalList">
        UPDATE found_portal
        SET is_deleted = 1
        WHERE atc_id = #{atcId}
    </update>

    <!-- 사용자 습득물 완료처리 -->
    <update id="completeFoundList">
        update found
        set done=1
        where atc_id=#{atcId}
    </update>

    <!-- 경찰청 습득물 완료처리 -->
    <update id="completeFoundPoliceList">
        update found_police
        set done=1
        where atc_id=#{atcId}
    </update>

    <!-- 포털 습득물 완료처리 -->
    <update id="completeFoundPortalList">
        update found_portal
        set done=1
        where atc_id=#{atcId}
    </update>

    <!-- 관리자 분실물 검색 + 페이징 조회 -->
    <select id="searchLostPage" resultMap="AdminLostResultMap">
        SELECT *
        FROM (
            SELECT
                num, atc_id, id, lst_place, lst_prdt_nm, lst_sbjt, lst_ymd,
                prdt_cl_nm, created_at, updated_at, done, is_deleted,
                lst_filepath_img, view_count, 'USER' AS data_source
            FROM lost
            <if test="!includeDeleted">
                where is_deleted = 0
            </if>
            <if test="includeDeleted">
                where is_deleted = 1
            </if>

            UNION ALL

            SELECT
                num, atc_id, id, lst_place, lst_prdt_nm, lst_sbjt, lst_ymd,
                prdt_cl_nm, created_at, updated_at, done, is_deleted,
                lst_filepath_img, view_count, 'POLICE' AS data_source
            FROM lost_police
            <if test="!includeDeleted">
                where is_deleted = 0
            </if>
            <if test="includeDeleted">
                where is_deleted = 1
            </if>
        ) A
        WHERE 1 = 1
        
        <include refid="lostSearchCondition"/>

        ORDER BY 
            created_at DESC, 
            CASE data_source
                WHEN 'USER' THEN 1
                WHEN 'POLICE' THEN 2
                ELSE 3
            END,
            done ASC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 관리자 분실물 검색 결과 개수 조회 -->
    <select id="countSearchLost" resultType="int">
        SELECT COUNT(*)
        FROM (
            SELECT
                lst_sbjt, lst_prdt_nm, id, prdt_cl_nm, done,
                created_at, 'USER' AS data_source
            FROM lost
            <if test="!includeDeleted">
                where is_deleted = 0
            </if>
            <if test="includeDeleted">
                where is_deleted = 1
            </if>

            UNION ALL

            SELECT
                lst_sbjt, lst_prdt_nm, id, prdt_cl_nm, done,
                created_at, 'POLICE' AS data_source
            FROM lost_police
            <if test="!includeDeleted">
                where is_deleted = 0
            </if>
            <if test="includeDeleted">
                where is_deleted = 1
            </if>
        ) A
        WHERE 1 = 1

        <include refid="lostSearchCondition"/>
    </select>

    <!-- 관리자 습득물 검색 + 페이징 조회 -->
    <select id="searchFoundPage"
            parameterType="com.human.found.domain.admin.vo.AdminSearchVO"
            resultMap="AdminFoundResultMap">

        SELECT *
        FROM (
            SELECT
                num,
                atc_id,
                id,
                clr_nm,
                dep_place,
                fd_filepath_img,
                fd_prdt_nm,
                fd_sbjt,
                fd_ymd,
                prdt_cl_nm,
                created_at,
                updated_at,
                done,
                is_deleted,
                'USER' AS data_source
            FROM found
            <if test="!includeDeleted">
                WHERE is_deleted = 0
            </if>
            <if test="includeDeleted">
                WHERE is_deleted = 1
            </if>

            UNION ALL

            SELECT
                num,
                atc_id,
                id,
                clr_nm,
                dep_place,
                fd_filepath_img,
                fd_prdt_nm,
                fd_sbjt,
                fd_ymd,
                prdt_cl_nm,
                created_at,
                updated_at,
                done,
                is_deleted,
                'POLICE' AS data_source
            FROM found_police
            <if test="!includeDeleted">
                WHERE is_deleted = 0
            </if>
            <if test="includeDeleted">
                WHERE is_deleted = 1
            </if>

            UNION ALL

            SELECT
                num,
                atc_id,
                id,
                clr_nm,
                dep_place,
                fd_filepath_img,
                fd_prdt_nm,
                fd_sbjt,
                fd_ymd,
                prdt_cl_nm,
                created_at,
                updated_at,
                done,
                is_deleted,
                'PORTAL' AS data_source
            FROM found_portal
            <if test="!includeDeleted">
                WHERE is_deleted = 0
            </if>
            <if test="includeDeleted">
                WHERE is_deleted = 1
            </if>
        ) total_found

        WHERE 1 = 1

        <include refid="foundSearchCondition"/>

        ORDER BY 
            created_at DESC, 
            CASE data_source
                WHEN 'USER' THEN 1
                WHEN 'POLICE' THEN 2
                ELSE 3
            END,
            done ASC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 관리자 습득물 검색 결과 개수 조회 -->
    <select id="countSearchFound"
            parameterType="com.human.found.domain.admin.vo.AdminSearchVO"
            resultType="int">

        SELECT COUNT(*)
        FROM (
            SELECT
                fd_sbjt,
                fd_prdt_nm,
                id,
                prdt_cl_nm,
                done,
                created_at,
                'USER' AS data_source
            FROM found
            <if test="!includeDeleted">
                WHERE is_deleted = 0
            </if>
            <if test="includeDeleted">
                WHERE is_deleted = 1
            </if>

            UNION ALL

            SELECT
                fd_sbjt,
                fd_prdt_nm,
                id,
                prdt_cl_nm,
                done,
                created_at,
                'POLICE' AS data_source
            FROM found_police
            <if test="!includeDeleted">
                WHERE is_deleted = 0
            </if>
            <if test="includeDeleted">
                WHERE is_deleted = 1
            </if>

            UNION ALL

            SELECT
                fd_sbjt,
                fd_prdt_nm,
                id,
                prdt_cl_nm,
                done,
                created_at,
                'PORTAL' AS data_source
            FROM found_portal
            <if test="!includeDeleted">
                WHERE is_deleted = 0
            </if>
            <if test="includeDeleted">
                WHERE is_deleted = 1
            </if>
        ) total_found

        WHERE 1 = 1

        <include refid="foundSearchCondition"/>
    </select>

    <!-- 분실물 검색 조건 -->
    <sql id="lostSearchCondition">
        <if test="keyword != null and keyword != ''">
            AND (
                lst_sbjt LIKE CONCAT('%', #{keyword}, '%')
                OR lst_prdt_nm LIKE CONCAT('%', #{keyword}, '%')
                OR id LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>

        <if test="categories != null and categories.size() > 0">
            AND prdt_cl_nm IN
            <foreach collection="categories" item="category" open="(" separator="," close=")">
                #{category}
            </foreach>
        </if>

        <if test="doneList != null and doneList.size() > 0">
            AND done IN
            <foreach collection="doneList" item="done" open="(" separator="," close=")">
                #{done}
            </foreach>
        </if>

        <if test="startDate != null and startDate != ''">
            AND DATE(created_at) &gt;= #{startDate}
        </if>

        <if test="endDate != null and endDate != ''">
            AND DATE(created_at) &lt;= #{endDate}
        </if>

        <if test="dataSources != null and dataSources.size() > 0">
            AND data_source IN
            <foreach collection="dataSources" item="source" open="(" separator="," close=")">
                #{source}
            </foreach>
        </if>
    </sql>

    <!-- 습득물 검색 조건 -->
    <sql id="foundSearchCondition">
        <if test="keyword != null and keyword != ''">
            AND (
                fd_sbjt LIKE CONCAT('%', #{keyword}, '%')
                OR fd_prdt_nm LIKE CONCAT('%', #{keyword}, '%')
                OR id LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>

        <if test="categories != null and categories.size() > 0">
            AND prdt_cl_nm IN
            <foreach collection="categories"
                    item="category"
                    open="("
                    separator=","
                    close=")">
                #{category}
            </foreach>
        </if>

        <if test="doneList != null and doneList.size() > 0">
            AND done IN
            <foreach collection="doneList"
                    item="done"
                    open="("
                    separator=","
                    close=")">
                #{done}
            </foreach>
        </if>

        <if test="startDate != null and startDate != ''">
            AND DATE(created_at) &gt;= #{startDate}
        </if>

        <if test="endDate != null and endDate != ''">
            AND DATE(created_at) &lt;= #{endDate}
        </if>

        <if test="dataSources != null and dataSources.size() > 0">
            AND data_source IN
            <foreach collection="dataSources"
                    item="source"
                    open="("
                    separator=","
                    close=")">
                #{source}
            </foreach>
        </if>
    </sql>

</mapper>